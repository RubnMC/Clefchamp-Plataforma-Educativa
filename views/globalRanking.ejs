<!DOCTYPE html>
<html lang="es">
  <%-include('partials/head') %>
  <body class="colorNuevo5">
    <%-include('partials/header') %>
    <div class="row d-flex">
      <div class="col scrollable container-fluid vh-90 mx-sm-5">
        <div class="mb-3">

        <div class="d-flex flex-wrap bg-15 rounded-4 mb-sm-4 mb-1 mx-1 p-2 gap-1">
          <% levelsRes.forEach(function(level, i) { %>
            <% const domId = level.id.replace(/-/g, '_'); %>
            <button class="rankingLevelBtn btn btn-sm btn-outline-secondary" data-level-id="<%=level.id%>" data-dom-id="<%=domId%>">
              <%=level.name%>
            </button>
          <% }); %>
        </div>

        <% levelsRes.forEach(function(level, i) { %>
          <% const domId = level.id.replace(/-/g, '_'); %>
          <% level.res.forEach(function(entry, j) { %>
            <div class="row bg-15 rounded-4 mx-1 mt-1 px-sm-2 ranking_<%=domId%>" <%= i !== 0 ? 'hidden' : '' %>>
              <!-- PC View -->
              <div class="d-none d-md-flex w-100">
                <div class="col-1 d-flex">
                  <h1 class="my-auto bg-15 rounded-4 p-sm-3 px-sm-4 p-1 h1Profile"><%= j + 1 %>.</h1>
                </div>
                <div class="col-auto align-items-center d-flex">
                  <div style="background-color: <%= entry.bgColor %>; width: 80px; height: 80px;" class="rounded-circle d-flex justify-content-center align-items-center">
                    <img src="/images/svg/<%=entry.path%>" class="profileSvg" alt="Icono de perfil del usuario">
                  </div>
                </div>
                <div class="col-2 d-flex">
                  <div class="my-auto">
                    <h1 class="h1Profile"><%= entry.tagname %></h1>
                    <h4 class="h4Profile"><%= entry.friendCode %></h4>
                  </div>
                </div>
                <div class="col">
                  <div class="row">
                    <div class="col pt-4 d-flex align-items-center">
                      <h3 class="h3Profile"><%=level.name%></h3>
                    </div>
                    <div class="col">
                      <h5 class="text-center"><span class="display-1"><%= entry.points %></span> ptos.</h5>
                    </div>
                    <div class="col text-end">
                      <span class="fs-3"><%= entry.time.day %>-<%= entry.time.month %>-<%= entry.time.year %></span>
                      <% if (entry.time.hour !== undefined) { %>
                        <div><span class="fs-sm-5"><%= entry.time.hour %>:<%= entry.time.minutes %></span></div>
                      <% } %>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Mobile View -->
              <div class="d-md-none d-flex w-100 px-1 align-items-center">
                <div class="col-1 justify-content-center d-flex">
                  <h1 class="my-auto bg-15 rounded-4 p-1 h1Profile"><%= j + 1 %>.</h1>
                </div>
                <div class="col-2 align-items-center mb-2">
                    <div style="background-color: <%= entry.bgColor %>; width: 60px; height: 60px;" class="rounded-circle d-flex justify-content-center align-items-center">
                      <img src="/images/svg/<%=entry.path%>" class="profileSvg" style="max-width: 40px; max-height: 40px;" alt="Icono de perfil del usuario">
                    </div>
                    <h1 class="h1Profile mb-0"><%= entry.tagname %></h1>
                    <h4 class="h4Profile mb-0"><%= entry.friendCode %></h4>
                </div>
                <div class="col-2 ps-1">
                  <h3 class="h4Profile mb-0"><%=level.name%></h3>
                </div>
                <div class="col">
                  <h5 class="text-center mb-0"><span class="display-5"><%= entry.points %></span> ptos.</h5>
                </div>
                <div class="col text-end">
                  <span class="fs-6"><%= entry.time.day %>/<%= entry.time.month %>/<%= entry.time.year %></span>
                  <% if (entry.time.hour !== undefined) { %>
                    <div><span class="fs-6"><%= entry.time.hour %>:<%= entry.time.minutes %></span></div>
                  <% } %>
                </div>
              </div>
            </div>
          <% }); %>
        <% }); %>
      </div>
    </div>
  </div>
    <%-include('partials/footer') %>
    <script src="/javascripts/clipboard.js"></script>
    <script src="/javascripts/ranking.js"></script>
    <script>
      const rankingBtns = document.querySelectorAll('.rankingLevelBtn');

      function activateRankingLevel(levelId) {
        const btn = document.querySelector(`.rankingLevelBtn[data-level-id="${levelId}"]`);
        if (!btn) return;
        const domId = btn.dataset.domId;
        document.querySelectorAll('[class*="ranking_"]').forEach(el => el.hidden = true);
        document.querySelectorAll('.ranking_' + domId).forEach(el => el.hidden = false);
        rankingBtns.forEach(b => { b.classList.remove('btn-light'); b.classList.add('btn-outline-secondary'); });
        btn.classList.remove('btn-outline-secondary');
        btn.classList.add('btn-light');
      }

      rankingBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const levelId = this.dataset.levelId;
          activateRankingLevel(levelId);
          localStorage.setItem('rankingLastLevel', levelId);
        });
      });

      const savedLevel  = localStorage.getItem('rankingLastLevel');
      const firstBtn    = rankingBtns[0];
      const initialId   = savedLevel && document.querySelector(`.rankingLevelBtn[data-level-id="${savedLevel}"]`)
        ? savedLevel
        : (firstBtn ? firstBtn.dataset.levelId : null);
      if (initialId) activateRankingLevel(initialId);
    </script>
  </body>
</html>
