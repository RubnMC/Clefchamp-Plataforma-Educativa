<!DOCTYPE html>
<html lang="es">
  <%- include('../partials/head') %>
  <body class="colorNuevo5">
    <%- include('../partials/header') %>
    <div class="container py-4">
      <h1 class="mb-4">Mis alumnos</h1>

      <div class="card mb-4 shadow-sm">
        <div class="card-body">
          <h5 class="card-title">Enlace de invitación</h5>
          <p class="card-text text-muted">Comparte este enlace con tus alumnos para que se unan a tu clase.</p>
          <div class="input-group">
            <input type="text" class="form-control bg-light" id="inviteUrl" readonly value="<%= joinLink %>">
            <button class="btn btn-outline-secondary" id="copyInviteBtn" type="button">
              <img src="/images/icons/copy.svg" id="copyInviteImg" style="width:20px;" alt="Copiar">
            </button>
          </div>
        </div>
      </div>

      <ul class="nav nav-tabs mb-3" id="teacherTabs" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" id="tab-alumnos" data-bs-toggle="tab"
                  data-bs-target="#panel-alumnos" type="button" role="tab">Alumnos</button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="tab-niveles" data-bs-toggle="tab"
                  data-bs-target="#panel-niveles" type="button" role="tab">Niveles</button>
        </li>
      </ul>

      <div class="tab-content">
        <div class="tab-pane fade show active" id="panel-alumnos" role="tabpanel">
          <div id="navContainer">
        <% if (students.length === 0) { %>
          <div class="alert alert-info">
            Aún no tienes alumnos asignados. Comparte tu código de profesor
            (<strong><%= user.friendCode %></strong>) para que los alumnos puedan unirse.
          </div>
        <% } else { %>
          <div class="row row-cols-1 row-cols-md-3 g-3">
            <% students.forEach(function(student) { %>
              <div class="col">
                <div class="position-relative">
                  <a href="/teacher/students/<%= student.id %>" class="text-decoration-none text-dark">
                    <div class="card h-100 shadow-sm">
                      <div class="card-body d-flex align-items-center gap-3">
                        <img src="/images/svg/<%= student.path %>"
                             style="width:48px;height:48px;border-radius:50%;background:<%= student.bgColor %>;object-fit:contain;"
                             alt="Avatar">
                        <div>
                          <div class="fw-bold"><%= student.tagname %></div>
                          <small class="text-muted d-block">Nivel <%= student.level ?? '—' %></small>
                          <% const lastLvl = student.lastPlayedLevelId != null ? levels.find(l => l.id === student.lastPlayedLevelId) : null; %>
                          <small class="text-muted d-block">
                            Ultima partida:
                            <% if (student.lastPlayed) { %>
                              <% if (lastLvl) { %><span class="fw-semibold"><%= lastLvl.name %></span> — <% } %>
                              <%= formatDateTime(student.lastPlayed) %> (<%= relativeTime(student.lastPlayed) %>)
                            <% } else { %>
                              Never played
                            <% } %>
                          </small>
                          <div class="d-flex gap-2 mt-1 flex-wrap">
                            <%- include('../partials/svg/trophy', { count: student.top1Count, color: '#FFD700', textColor: 'black', label: '1° puesto' }) %>
                            <%- include('../partials/svg/trophy', { count: student.top2Count, color: '#A8A8A8', textColor: 'black', label: '2° puesto' }) %>
                            <%- include('../partials/svg/trophy', { count: student.top3Count, color: '#CD7F32', textColor: 'black', label: '3° puesto' }) %>
                          </div>
                        </div>
                      </div>
                    </div>
                  </a>
                  <button class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2 remove-student-btn"
                          data-student-id="<%= student.id %>"
                          data-student-name="<%= student.tagname %>"
                          style="z-index:1;">&times;</button>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>
          </div>
        </div>
        <div class="tab-pane fade" id="panel-niveles" role="tabpanel">
          <div class="row row-cols-1 row-cols-md-3 g-3">
            <% levels.forEach(function(lvl) { %>
              <div class="col">
                <div class="card h-100 shadow-sm">
                  <div class="card-body">
                    <span class="badge bg-secondary me-1">LV.<%= lvl.num %></span>
                    <span class="badge bg-light text-dark"><%= lvl.category %></span>
                    <h6 class="card-title mt-2 mb-1"><%= lvl.name %></h6>
                    <button type="button"
                            class="btn btn-sm btn-outline-success w-100 manage-level-btn"
                            data-level-id="<%= lvl.id %>">Gestionar acceso</button>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    </div>
    <%- include('../partials/footer') %>
    <%- include('./studentsModal') %>
    <script>
      document.querySelectorAll('.remove-student-btn').forEach(function(btn) {
        btn.addEventListener('click', function(e) {
          e.preventDefault();
          e.stopPropagation();
          const id = this.dataset.studentId;
          const name = this.dataset.studentName;
          if (!confirm('¿Eliminar a ' + name + ' de tu clase?')) return;
          fetch('/teacher/students/' + id + '/remove', { method: 'POST' })
            .then(function(r) { return r.json(); })
            .then(function(data) {
              if (data.ok) btn.closest('.col').remove();
              else alert('Error al eliminar al alumno.');
            })
            .catch(function() { alert('Error de red.'); });
        });
      });

      (function() {
        const stored = localStorage.getItem('teacherTab');
        if (stored) {
          const btn = document.querySelector('[data-bs-target="' + stored + '"]');
          if (btn) bootstrap.Tab.getOrCreateInstance(btn).show();
        }
        document.querySelectorAll('#teacherTabs [data-bs-toggle="tab"]').forEach(function(btn) {
          btn.addEventListener('shown.bs.tab', function() {
            localStorage.setItem('teacherTab', btn.dataset.bsTarget);
          });
        });
      })();

      document.getElementById('copyInviteBtn').addEventListener('click', function() {
        const url = document.getElementById('inviteUrl').value;
        const img = document.getElementById('copyInviteImg');
        (navigator.clipboard?.writeText(url) ?? Promise.reject())
          .catch(function() {
            var t = document.createElement('textarea');
            t.value = url;
            document.body.appendChild(t);
            t.select();
            document.execCommand('copy');
            document.body.removeChild(t);
          })
          .finally(function() {
            img.src = '/images/icons/copyready.svg';
            setTimeout(function() { img.src = '/images/icons/copy.svg'; }, 2000);
          });
      });

      (function() {
        function escapeHtml(str) {
          return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        var currentLevelId = null;
        var manageModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('manageAccessModal'));

        document.querySelectorAll('.manage-level-btn').forEach(function(btn) {
          btn.addEventListener('click', function() {
            currentLevelId = this.dataset.levelId;

            document.getElementById('modalLoadingSpinner').classList.remove('d-none');
            document.getElementById('studentsAccessTable').classList.add('d-none');
            document.getElementById('modalFetchError').classList.add('d-none');
            document.getElementById('noStudentsMsg').classList.add('d-none');
            document.getElementById('saveErrorMsg').classList.add('d-none');
            document.getElementById('masterCheckbox').checked = false;
            document.getElementById('studentsAccessTbody').innerHTML = '';

            manageModal.show();

            fetch('/teacher/levels/' + currentLevelId + '/students')
              .then(function(r) { return r.json(); })
              .then(function(data) {
                document.getElementById('modalLoadingSpinner').classList.add('d-none');
                if (!data.students || data.students.length === 0) {
                  document.getElementById('noStudentsMsg').classList.remove('d-none');
                  return;
                }
                var tbody = document.getElementById('studentsAccessTbody');
                data.students.forEach(function(s) {
                  var tr = document.createElement('tr');
                  tr.innerHTML =
                    '<td>' + escapeHtml(s.tagname) + '</td>' +
                    '<td class="text-center"><input type="checkbox" class="form-check-input student-access-cb"' +
                    ' data-student-id="' + s.id + '"' + (s.isUnlocked ? ' checked' : '') + '></td>';
                  tbody.appendChild(tr);
                });
                document.getElementById('studentsAccessTable').classList.remove('d-none');
              })
              .catch(function() {
                document.getElementById('modalLoadingSpinner').classList.add('d-none');
                document.getElementById('modalFetchError').classList.remove('d-none');
              });
          });
        });

        document.getElementById('masterCheckbox').addEventListener('change', function() {
          var checked = this.checked;
          document.querySelectorAll('.student-access-cb').forEach(function(cb) { cb.checked = checked; });
        });

        document.getElementById('saveAccessBtn').addEventListener('click', function() {
          var students = [];
          document.querySelectorAll('.student-access-cb').forEach(function(cb) {
            students.push({ studentId: parseInt(cb.dataset.studentId, 10), unlocked: cb.checked });
          });

          document.getElementById('saveErrorMsg').classList.add('d-none');

          fetch('/teacher/levels/' + currentLevelId + '/bulk-access', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ students: students })
          })
            .then(function(r) { return r.json(); })
            .then(function(data) {
              if (data.ok) manageModal.hide();
              else document.getElementById('saveErrorMsg').classList.remove('d-none');
            })
            .catch(function() {
              document.getElementById('saveErrorMsg').classList.remove('d-none');
            });
        });
      })();
    </script>
  </body>
</html>
