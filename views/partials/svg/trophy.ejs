<% if (count > 0) { %>
  <div title="<%= label %>" style="
    position: relative;
    width: 26px;
    height: 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  ">
    <div style="
      position: absolute;
      inset: 0;
      background-color: <%= color %>;
      mask: url('/images/icons/trophy.svg') no-repeat center / contain;
      -webkit-mask: url('/images/icons/trophy.svg') no-repeat center / contain;
    "></div>
    <span style="
      position: relative;
      font-size: 8px;
      font-weight: bold;
      color: <%= textColor %>;
      line-height: 1;
      margin-top: -4px;
    "><%= count %></span>
  </div>
<% } %>
