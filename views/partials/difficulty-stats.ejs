<% const s = stats[difficulty] || {}; %>
<% const domId = difficulty.replace(/-/g, '_'); %>
<div class="rounded-4 bg-15 p-3 mb-4 levelStatsDiv" data-level-id="<%=difficulty%>" <%=hidden ? 'hidden' : ''%>>
  <h5 class="mb-3 text-muted"><%=levelName%></h5>
  <div class="bg-10 p-3 d-flex flex-column col align-items-center justify-content-center">
    <div class="row w-100">
      <div class="col" id="chart_<%=domId%>" style="width: 60vw; height: 25vh;padding:0;"></div>
    </div>
    <div class="row d-none text-center w-100 px-4 rounded-4" style="background-color: #dccfca;padding-top: 5rem;padding-bottom: 5rem;" id="nodata_<%=domId%>">
      <h4 class="text-muted">No hay suficientes datos para crear la gráfica</h4>
    </div>
    <div class="d-flex justify-content-between w-100 my-sm-4 mt-1 row">
      <div class="bg-15 rounded-4 p-2 d-flex flex-column align-items-center col-sm-2 col-12 mb-sm-0 mb-1">
        <p class="mb-2">Puntuación más alta</p>
        <div class="d-flex flex-column align-items-center gap-2">
          <div class="d-flex align-items-center gap-2">
            <img class="statsSvg" src="/images/icons/trophy.svg" alt="">
            <span id="bestScore_<%=domId%>" class="h3 mb-0"></span>
          </div>
          <small id="bestDate_<%=domId%>" class="text-muted"></small>
        </div>
      </div>

      <div class="bg-15 rounded-4 p-2 d-flex flex-column align-items-center col-sm-2 col-12 mb-sm-0 mb-1">
        <p class="mb-2">Partidas jugadas</p>
        <div class="d-flex align-items-center gap-2">
          <img src="/images/icons/treble.svg" style="max-height: 4em;" alt="">
          <span class="h3 mb-0"><%=s.gamesPlayed || 0%></span>
        </div>
      </div>

      <div class="bg-15 rounded-4 p-2 d-flex flex-column align-items-center col-sm-2 col-12 mb-sm-0 mb-1">
        <p class="mb-2">Posición en el ranking</p>
        <div class="d-flex align-items-center justify-content-center gap-2 h-100">
          <img class="statsSvg" src="/images/icons/ranking.svg" alt="">
          <span class="h3 mb-0"><%=s.rank || '-'%></span>
        </div>
      </div>

      <div class="bg-15 rounded-4 p-2 d-flex flex-column align-items-center col-sm-2 col-12 mb-sm-0 mb-1">
        <p class="mb-2">Última partida</p>
        <div class="d-flex align-items-center gap-2 justify-content-center h-100">
          <img class="statsSvg" src="/images/icons/lastPlayed.svg" alt="">
          <span id="lastPlayed_<%=domId%>" class="h4 my-auto"></span>
        </div>
      </div>
    </div>

    <div class="w-100">
      <div class="bg-15 rounded-4 p-2 d-flex align-items-center justify-content-center mb-3">
        <div class="d-flex align-items-center gap-2">
          <p class="my-auto">Porcentaje de aciertos:</p>
          <span class="h3 mb-0"><%=s.accuracy || '-'%>%</span>
          <p class="my-auto">de los cuales:</p>
        </div>
      </div>

      <div class="progress-stacked w-100 mb-3">
        <div class="progress" role="progressbar" aria-valuenow="15" aria-valuemin="0" aria-valuemax="100" style="width: <%=s.ok || 0%>%">
          <div class="progress-bar" style="background-color: rgba(255, 102, 0,0.4);"></div>
        </div>
        <div class="progress" role="progressbar" aria-valuenow="30" aria-valuemin="0" aria-valuemax="100" style="width: <%=s.good || 0%>%">
          <div class="progress-bar" style="background-color:rgba(0, 255, 55,0.4)"></div>
        </div>
        <div class="progress" role="progressbar" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100" style="width: <%=s.great || 0%>%">
          <div class="progress-bar" style="background-color: rgba(0, 162, 255,0.4);"></div>
        </div>
        <div class="progress" role="progressbar" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100" style="width: <%=s.excellent || 0%>%">
          <div class="progress-bar" style="background-color: rgba(174, 0, 255,0.4);"></div>
        </div>
        <div class="progress" role="progressbar" aria-valuenow="20" aria-valuemin="0" aria-valuemax="100" style="width: <%=s.perfect || 0%>%">
          <div class="progress-bar" style="background-color: rgba(255, 251, 0,0.4);"></div>
        </div>
      </div>

      <div class="d-flex justify-content-between w-100">
        <div class="rounded-4 p-2 d-flex flex-column align-items-center" style="background-color: rgba(255, 102, 0, 0.4);width: 18%;">
          <p class="my-auto notesDescriptor">Ok</p>
          <div class="d-flex align-items-center gap-2">
            <span class="myh3"><%=s.ok || 0%>%</span>
          </div>
        </div>
        <div class="rounded-4 p-2 d-flex flex-column align-items-center" style="background-color: rgba(0, 255, 55, 0.4);width: 18%;">
          <p class="my-auto notesDescriptor">Bien</p>
          <div class="d-flex align-items-center gap-2">
            <span class="myh3"><%=s.good || 0%>%</span>
          </div>
        </div>
        <div class="rounded-4 p-2 d-flex flex-column align-items-center" style="background-color: rgba(0, 162, 255, 0.4);width: 18%;">
          <p class="my-auto notesDescriptor">Genial</p>
          <div class="d-flex align-items-center gap-2">
            <span class="myh3"><%=s.great || 0%>%</span>
          </div>
        </div>
        <div class="rounded-4 p-2 d-flex flex-column align-items-center" style="background-color: rgba(174, 0, 255, 0.4);width: 18%;">
          <p class="my-auto notesDescriptor">Excelente</p>
          <div class="d-flex align-items-center gap-2">
            <span class="myh3"><%=s.excellent || 0%>%</span>
          </div>
        </div>
        <div class="rounded-4 p-2 d-flex flex-column align-items-center" style="background-color: rgba(255, 251, 0, 0.4);width: 18%;">
          <p class="my-auto notesDescriptor">Perfecto</p>
          <div class="d-flex align-items-center gap-2">
            <span class="myh3"><%=s.perfect || 0%>%</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
