<!DOCTYPE html>
<html lang="es">
  <%-include('partials/head') %>
  <body class="colorNuevo5">
    <%-include('partials/header') %>
    <div class="vh-90" style="overflow: hidden; display: flex; flex-direction: column;">
      <div class="container-fluid p-4" style="flex: 1; min-height: 0;">
        <div class="row g-4" style="height: 100%;">

          <!-- Left Column - Level Detail -->
          <div class="col-12 col-lg-4" style="height: 100%; overflow-y: auto;">
            <div id="levelDetailPanel" class="bg-15 rounded-4 p-4" style="height: 100%;">
              <div id="levelDetail"></div>
            </div>
          </div>

          <!-- Right Column - Level List -->
          <div class="col-12 col-lg-8" style="height: 100%; display: flex; flex-direction: column;">
            <div class="bg-15 rounded-4 p-3 mb-3 phoneHidden" style="flex-shrink: 0;">
              <h2 class="text-center mb-0">Elige un nivel</h2>
            </div>
            <div id="levelList" class="scrollable" style="flex: 1; min-height: 0;"></div>
          </div>

        </div>
      </div>
    </div>
    <%-include('partials/footer') %>
    <script src="/javascripts/levelButtons.js"></script>
    <script src="/javascripts/selectGame.js"></script>
  </body>
</html>
